{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中标狗",
  "mainBinaryName": "bid-assistant",
  "version": "0.21.1",
  "identifier": "com.shandiant.bidassistant",
  "build": {
    "frontendDist": "../../app-next/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "中标狗",
        "url": "index.html?desktop=0.21.1-18901",
        "incognito": true,
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "hardenedRuntime": false
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "externalBin": [
      "binaries/bid-engine",
      "binaries/opencode-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://bid-dog.vercel.app/updater/{{target}}-{{arch}}.json",
        "https://github.com/shandianT/bid-dog/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRENBQzQxQkJGRjUxQUYKUldTdlVmKzdRYXpjVTYyQlZXTmNkK2pSUmhDL0ZYVFJ4RlBCdTJlalErbk9DL3k1aG1XK1VGSy8K"
    }
  }
}
